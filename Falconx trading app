        }

        // Ƙirƙirar JWT Token wanda zai dore na awa 24
        const token = jwt.sign({ userId: user.id, email: user.email }, JWT_SECRET, { expiresIn: '24h' });

        res.status(200).json({
            status: 'SUCCESS',
            message: 'An shiga asusu cikin nasira',
            token: token,
            userId: user.id
        });
    } catch (error) {
        res.status(500).json({ status: 'ERROR', message: 'Kuskure wajen shiga asusu', error: error.message });
    }
});

// 2. Middleware na Tsaro (Kare API endpoints daga shiga ba tare da izini ba)
function verifyToken(req, res, next) {
    const authHeader = req.headers['authorization'];
    const token = authHeader && authHeader.split(' ')[1]; // Bearer TOKEN

    if (!token) {
        return res.status(401).json({ status: 'ERROR', message: 'An hana shiga! Babu Token.' });
    }

    jwt.verify(token, JWT_SECRET, (err, user) => {
        if (err) {
            return res.status(403).json({ status: 'ERROR', message: 'Token din ya ƙare ko bai da inganci.' });
        }
        req.user = user;
        next();
    });
}

// 3. Misali na Protected Endpoint (Wuri na musamman da sai da Token ake shiga)
app.get('/api/user/profile', verifyToken, async (req, res) => {
    try {
        const user = await prisma.user.findUnique({
            where: { id: req.user.userId },
            include: { wallets: true }
        });
        res.status(200).json({ status: 'SUCCESS', user });
    } catch (error) {
        res.status(500).json({ status: 'ERROR', message: 'Matsala wajen jawo bayanan mai amfani.' });
    }
});

