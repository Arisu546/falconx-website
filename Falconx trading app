const http = require('http');
const express = require('express');
const { WebSocketServer } = require('ws');

const app = express();
const server = http.createServer(app);
const wss = new WebSocketServer({ server });

// Ajiye masu amfani da suka haɗu (Active Connections)
const clients = new Map();

wss.on('connection', (ws, req) => {
    // Kuna iya fitar da userId daga URL params, misali: ws://localhost:8080?userId=123
    const urlParams = new URLSearchParams(req.url.split('?')[1]);
    const userId = urlParams.get('userId');

    if (userId) {
        clients.set(userId, ws);
        console.log(`Mai amfani mai ID: ${userId} ya haɗu da Real-time WebSocket.`);
    }

    ws.on('message', (message) => {
        console.log(`An karɓi saƙo daga abokin ciniki: ${message}`);
    });

    ws.on('close', () => {
        if (userId) {
            clients.delete(userId);
            console.log(`Mai amfani mai ID: ${userId} ya katse haɗin.`);
        }
    });
});

// Aiki na Tura Sanarwa (Notification) ga takamaiman Mai Amfani
function sendRealTimeNotification(userId, notificationData) {
    const clientWs = clients.get(userId);
    if (clientWs && clientWs.readyState === clientWs.OPEN) {
        clientWs.send(JSON.stringify(notificationData));
        console.log(`An tura sanarwa zuwa ga mai amfani: ${userId}`);
    }
}

// Misali na Endpoint wanda zai iya kiran aikin tura sanarwa idan wani abu ya faru
app.post('/api/notify', express.json(), (req, res) => {
    const { userId, title, message } = req.body;
    sendRealTimeNotification(userId, { type: 'ALERT', title, message, time: new Date() });
    res.status(200).json({ status: 'SUCCESS', message: 'An tura sanarwar cikin nasira' });
});

server.listen(8080, () => {
    console.log('WebSocket Server yana aiki a tashar port 8080');
});
// NotificationComponent.jsx - React Real-time WebSocket Client
import React, { useEffect, useState } from 'react';

export function RealTimeNotifications({ userId }) {
  const [notifications, setNotifications] = useState([]);
  const [connectionStatus, setConnectionStatus] = useState('An katse');

  useEffect(() => {
    if (!userId) return;

    // Haɗawa da WebSocket server tare da wuce userId a cikin query
    const ws = new WebSocket(`ws://localhost:8080?userId=${userId}`);

    ws.onopen = () => {
      setConnectionStatus('An haɗa (Live)');
      console.log('WebSocket Connection Active');
    };

    ws.onmessage = (event) => {
      const data = JSON.parse(event.data);
      // Ƙara sabuwar sanarwa zuwa cikin jerin sanarwa
      setNotifications((prev) => [data, ...prev]);
    };

    ws.onclose = () => {
      setConnectionStatus('An katse (Disconnected)');
      console.log('WebSocket Connection Closed');
    };

    return () => {
      ws.close();
    };
  }, [userId]);

  return (
    <div style={{ padding: '20px', backgroundColor: '#1e2329', color: '#fff', borderRadius: '8px', maxWidth: '400px' }}>
      <h3>Sanarwar Lokaci-Guda (Live Notifications)</h3>
      <p>Matsayi: <span style={{ color: connectionStatus.includes('Live') ? '#0ecb81' : '#f6465d' }}>{connectionStatus}</span></p>

      <div style={{ marginTop: '15px', maxHeight: '200px', overflowY: 'auto' }}>
        {notifications.length === 0 ? (
          <p style={{ color: '#848e9c' }}>Babu sabbin sanarwa a yanzu.</p>
        ) : (
          notifications.map((notif, index) => (
            <div key={index} style={{ background: '#2b313a', padding: '10px', borderRadius: '6px', marginBottom: '10px' }}>
              <h4 style={{ margin: '0 0 5px 0', color: '#0ecb81' }}>{notif.title}</h4>
              <p style={{ margin: '0 0 5px 0', fontSize: '14px' }}>{notif.message}</p>
              <small style={{ color: '#848e9c' }}>{new Date(notif.time).toLocaleTimeString()}</small>
            </div>
          ))
        )}
      </div>
    </div>
  );
}
