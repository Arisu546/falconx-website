const express = require('express');
const http = require('http');
const { WebSocketServer } = require('ws');
const cors = require('cors');
const jwt = require('jsonwebtoken');
const bcrypt = require('bcrypt');
const { PrismaClient } = require('@prisma/client');

const app = express();
const server = http.createServer(app);
const wss = new WebSocketServer({ server });
const prisma = new PrismaClient();

app.use(express.json());
app.use(cors());

const JWT_SECRET = 'SUPER_SECRET_CRYPTO_KEY_2026';

// Ajiye masu amfani da suka haɗu da WebSocket (Active WS Clients)
const clients = new Map();

wss.on('connection', (ws, req) => {
    const urlParams = new URLSearchParams(req.url.split('?')[1]);
    const userId = urlParams.get('userId');

    if (userId) {
        clients.set(userId, ws);
        console.log(`[WebSocket] Mai amfani ${userId} ya haɗu.`);
    }

    ws.on('close', () => {
        if (userId) {
            clients.delete(userId);
            console.log(`[WebSocket] Mai amfani ${userId} ya katse.`);
        }
    });
});

function notifyUser(userId, data) {
    const ws = clients.get(userId);
    if (ws && ws.readyState === ws.OPEN) {
        ws.send(JSON.stringify(data));
    }
}

// 1. REGISTER ENDPOINT
app.post('/api/auth/register', async (req, res) => {
    try {
        const { email, password } = req.body;
        const existing = await prisma.user.findUnique({ where: { email } });
        if (existing) return res.status(400).json({ status: 'ERROR', message: 'Imel din yana da mai shi riga.' });

        const passwordHash = await bcrypt.hash(password, 10);
        const user = await prisma.user.create({
            data: {
                email,
                passwordHash,
                wallets: {
                    create: [
                        { asset: 'USDT', balance: 5000.0 },
                        { asset: 'BTC', balance: 1.0 }
                    ]
                }
            },
            include: { wallets: true }
        });

        res.status(201).json({ status: 'SUCCESS', message: 'An buɗe asusu cikin nasira', user });
    } catch (err) {
        res.status(500).json({ status: 'ERROR', message: err.message });
    }
});

// 2. LOGIN ENDPOINT
app.post('/api/auth/login', async (req, res) => {
    try {
        const { email, password } = req.body;
        const user = await prisma.user.findUnique({ where: { email } });
        if (!user || !(await bcrypt.compare(password, user.passwordHash))) {
            return res.status(400).json({ status: 'ERROR', message: 'Imel ko kalmar sirri ba daidai ba ne.' });
        }

        const token = jwt.sign({ userId: user.id, email: user.email }, JWT_SECRET, { expiresIn: '24h' });
        res.status(200).json({ status: 'SUCCESS', token, userId: user.id });
    } catch (err) {
        res.status(500).json({ status: 'ERROR', message: err.message });
    }
});

