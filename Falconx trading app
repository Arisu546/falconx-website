// Sumsub KYC Webhook & Verification Handler (Express.js)
const express = require('express');
const crypto = require('crypto');
const app = express();

app.use(express.json());

// Secret key daga Sumsub dashboard din ka
const SUMSUB_WEBHOOK_SECRET_KEY = 'YOUR_SUMSUB_SECRET_KEY';

app.post('/api/kyc/webhook', (req, res) => {
    const signature = req.headers['x-payload-digest'];
    const payload = JSON.stringify(req.body);

    // Tabbatar da tsaro (Signature Verification)
    const computedSignature = crypto
        .createHmac('sha256', SUMSUB_WEBHOOK_SECRET_KEY)
        .update(payload)
        .digest('hex');

    if (signature !== computedSignature) {
        return res.status(403).send('An ƙunguruntar da tsaron Sakon (Invalid Signature)');
    }

    const { applicantId, reviewResult, externalUserId } = req.body;

    if (reviewResult && reviewResult.reviewAnswer === 'GREEN') {
        console.log(`An tantance mai amfani ${externalUserId} (Applicant ID: ${applicantId}) cikin nasara!`);
        // Sabunta matsayin mai amfani a database zuwa "VERIFIED"
    } else {
        console.log(`An ki amincewa da tantancewar mai amfani ${externalUserId}`);
        // Sabunta matsayin mai amfani zuwa "REJECTED"
    }

    res.status(200).send('An karɓi sakon KYC');
});
