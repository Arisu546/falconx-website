// schema.prisma - PostgreSQL Database Structure
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  passwordHash  String
  kycStatus     KycStatus   @default(PENDING)
  fireblocksId  String?     @unique
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  wallets       Wallet[]
  orders        Order[]
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  asset     String   // Misali: 'BTC', 'ETH', 'USDT'
  balance   Float    @default(0.0)
  locked    Float    @default(0.0) // Kuɗin da ke cikin bude-oda (Active Orders)
  updatedAt DateTime @updatedAt
}

model Order {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  symbol    String      // Misali: 'BTCUSDT'
  side      OrderSide   // BUY ko SELL
  type      OrderType   // LIMIT ko MARKET
  price     Float
  quantity  Float
  status    OrderStatus @default(OPEN)
  createdAt DateTime    @default(now())
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  LIMIT
  MARKET
}

enum OrderStatus {
  OPEN
  FILLED
  CANCELLED
}
