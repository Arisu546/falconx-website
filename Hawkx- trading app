import { useEffect, useState } from 'react';

type Market = {
  name: string;
  symbol: string;
  type: 'Crypto' | 'Forex' | 'Commodity' | 'Stocks';
  price: string;
  change: string;
  icon: string;
}

export function useAllMarkets() {
  const [markets, setMarkets] = useState<Market[]>([
    { name: 'Bitcoin', symbol: 'BTC', type: 'Crypto', price: '68,432', change: '+2.4%', icon: '₿' },
    { name: 'Gold', symbol: 'XAU/USD', type: 'Commodity', price: '2,450', change: '-0.3%', icon: '🪙' },
    { name: 'EUR/USD', symbol: 'EURUSD', type: 'Forex', price: '1.0845', change: '+0.12%', icon: '💱' },
    { name: 'Apple Inc.', symbol: 'AAPL', type: 'Stocks', price: '210.45', change: '+1.8%', icon: '🍎' },
  ]);

  useEffect(() => {
    // Nan ne za ka hada da APIs
    // 1. Crypto = Binance API: https://api.binance.com/api/v3/ticker/price?symbol=BTCUSDT
    // 2. Forex/Gold/Stocks = TwelveData API (kyauta)
    
    const fetchPrices = async () => {
      // Misali na fetching
      console.log("HAWK X yana dauko farashin kasuwanni...");
    }
    
    fetchPrices();
    const interval = setInterval(fetchPrices, 10000); // kowace 10 seconds
    return () => clearInterval(interval);
  }, []);

  return markets;
}
// File: components/Watchlist.tsx
export function Watchlist() {
  const markets = useAllMarkets();
  return (
    <div className="bg-[#0F0F14] p-4">
      {markets.map(m => (
        <div key={m.symbol} className="flex justify-between p-3 mb-2 bg-[#1A1A24] rounded-xl">
          <div>
            <p className="text-white font-bold">{m.name}</p>
            <p className="text-xs text-gray-400">{m.type} • {m.symbol}</p>
          </div>
          <div className="text-right">
            <p className="text-white font-mono">${m.price}</p>
            <p className={m.change.includes('+') ? 'text-green-400' : 'text-red-400'}>{m.change}</p>
          </div>
        </div>
      ))}
    </div>
  )
}
